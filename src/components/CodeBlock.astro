---
import CopyButton from './CopyButton.astro';

interface Props {
  code: string;
  label?: string;
  lang?: string;
  copyable?: boolean;
}

const { code, label, lang = 'text', copyable = false } = Astro.props;
const id = `code-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="panel-dark relative">
  {
    label && (
      <div class="hairline-dark-b flex items-center justify-between bg-void-2 px-3.5 py-2">
        <span class="mono-micro text-fog-2">{label}{lang !== 'text' && <span> · {lang}</span>}</span>
        {copyable && <CopyButton target={id} />}
      </div>
    )
  }
  <pre id={id} class="term overflow-x-auto p-4 text-fog"><code>{code}</code></pre>
</div>