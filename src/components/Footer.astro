---
import { FOOTER_COLS } from '../lib/site';
import { localized, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-bg-raised)]">
  <div class="container-x py-14">

    <div class="grid gap-12 md:grid-cols-[1.4fr_repeat(3,1fr)]">

      <div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" class="text-[var(--color-text)]">
            <g fill="currentColor">
              <rect x="2" y="0" width="2" height="2"></rect>
              <rect x="6" y="0" width="2" height="2"></rect>
              <rect x="1" y="1" width="6" height="1"></rect>
              <rect x="2" y="2" width="4" height="1"></rect>
              <rect x="1" y="3" width="6" height="3"></rect>
              <rect x="0" y="4" width="8" height="2"></rect>
              <rect x="2" y="6" width="4" height="1"></rect>
            </g>
            <g fill="var(--color-bg-raised)">
              <rect x="3" y="3" width="1" height="1"></rect>
              <rect x="6" y="3" width="1" height="1"></rect>
            </g>
          </svg>
          <span class="font-display text-[1.0625rem] tracking-[-0.01em]">AXIUM</span>
        </div>
        <p class="mt-4 max-w-[22rem] text-sm leading-relaxed text-[var(--color-text-2)]">
          {lang === 'zh'
            ? '在你拥有的机器上运行代理，在你的掌控下协同工作。'
            : 'Agents that run on the machines you own, coordinated under your control.'}
        </p>
      </div>

      {
        FOOTER_COLS.map((col) => (
          <div>
            <p class="label mb-4 block">{col.title[lang]}</p>
            <ul class="space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={localized(l.href, lang)}
                    class="text-[0.8125rem] text-[var(--color-text-2)] transition-colors duration-150 hover:text-[var(--color-text)]"
                  >
                    {l.label[lang]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-[var(--color-border)] pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="mono-micro">© 2026 AXIUM</p>
      <p class="mono-micro">AX {lang === 'zh' ? '代理运行时' : 'runtime'} · AXCrew {lang === 'zh' ? '控制平面' : 'control plane'}</p>
    </div>
  </div>
</footer>
