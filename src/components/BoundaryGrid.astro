---
/**
 * BoundaryGrid — cross-machine boundaries (paper2 section):
 * every node is a closed box — workspace, sandbox, permissions —
 * and AXCrew routes between them without reaching into agent state.
 */
import { BOUNDARY_NOTES, BOUNDARY_NODES } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';
---

<div class="hairline border-line">
  <div class="hairline-b flex flex-wrap items-center justify-between gap-2 bg-paper-2 px-4 py-2.5">
    <span class="mono-micro text-ink-3">AXCrew · {z ? '控制平面' : 'control plane'}</span>
    <span class="mono-micro text-ink-3">{z ? '只路由任务 · 不触碰代理状态' : 'routes work · touches no agent state'}</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
    {
      BOUNDARY_NODES.map((n, i) => (
        <div class="relative border-line p-5 sm:border-r lg:border-b-0 lg:last:border-r-0 border-b last:border-b-0">
          <span class="mono-micro absolute right-3 top-3 tabular-nums text-ink-3">0{i + 1}</span>
          <p class="font-mono text-[0.8125rem] font-medium text-ink">{n.name[lang]}</p>
          <p class="mono-micro mt-1 text-ink-3">{n.detail[lang]}</p>
          <div class="mt-5 space-y-1.5">
            {
              n.labels.map((label) => (
                <p class="mono-micro text-ink-2">· {label[lang]}</p>
              ))
            }
          </div>
          <p class="mono-micro mt-5 text-ok">{z ? '● ed25519 · 已配对' : '● ed25519 · paired'}</p>
        </div>
      ))
    }
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-x-10 gap-y-2 sm:grid-cols-2 lg:grid-cols-4">
  {
    BOUNDARY_NOTES.map((note) => (
      <span class="datum">{note[lang]}</span>
    ))
  }
</div>
