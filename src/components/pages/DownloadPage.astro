---
/**
 * Download page — platforms, verify, update, windows. Bilingual.
 */
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import InstallCommand from '../../components/islands/InstallCommand';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';

const PLATFORM_ROWS: [string, string, string][] = z
  ? [
      ['macOS', 'arm64 · x64', 'curl 安装 · 原生二进制'],
      ['Linux', 'x64 · arm64', 'curl 安装 · 也支持 WSL（~/.local/bin/ax）'],
      ['Windows', 'x64', 'PowerShell 安装 · 原生或 WSL 执行'],
      ['Source', 'any', '从 ax 仓库构建 · cargo build --release'],
    ]
  : [
      ['macOS', 'arm64 · x64', 'curl install · native binary'],
      ['Linux', 'x64 · arm64', 'curl install · also inside WSL (~/.local/bin/ax)'],
      ['Windows', 'x64', 'PowerShell install · native or WSL execution'],
      ['Source', 'any', 'build from the ax repository · cargo build --release'],
    ];
---

<PageHero
  kicker={z ? '下载' : 'Download'}
  title={z ? '把 AX 装到机器上。' : 'Get AX on the machine.'}
  lead={z
    ? 'Windows、macOS、Linux 与 WSL 上同一个原生二进制——一条 curl 或 PowerShell 命令装好。发布物带 SHA256SUMS；ax --update 按精确 tag 校验。'
    : 'One native binary on Windows, macOS, Linux and WSL — installed with one curl or PowerShell command. Releases ship with SHA256SUMS; ax --update verifies against the exact tag.'}
/>

<Section>
  <div class="mx-auto max-w-3xl">
    <InstallCommand client:visible />
  </div>

  <div class="mx-auto mt-14 max-w-3xl">
    <div class="hairline border-line">
      <div class="grid grid-cols-[8rem_1fr] gap-x-6 border-b border-line bg-paper-2 px-4 py-2.5 sm:grid-cols-[10rem_8rem_1fr]">
        <span class="mono-micro">{z ? '平台' : 'platform'}</span>
        <span class="mono-micro hidden sm:block">{z ? '架构' : 'arch'}</span>
        <span class="mono-micro">{z ? '说明' : 'notes'}</span>
      </div>
      {
        PLATFORM_ROWS.map((row) => (
          <div class="grid grid-cols-[8rem_1fr] gap-x-6 border-b border-line px-4 py-3.5 sm:grid-cols-[10rem_8rem_1fr]">
            <span class="font-mono text-[0.8125rem] text-ink">{row[0]}</span>
            <span class="datum hidden sm:block">{row[1]}</span>
            <span class="datum">{row[2]}</span>
          </div>
        ))
      }
    </div>

    <p class="mono-micro mt-6">
      {z
        ? '安装器从 GitHub Release 拉取最新归档、校验 SHA256SUMS 后安装单个二进制；也可用 AX_VERSION 指定 tag、AX_INSTALL_DIR 指定目录。'
        : 'Installers fetch the latest GitHub release, verify SHA256SUMS, then install a single binary; pin a tag with AX_VERSION or a directory with AX_INSTALL_DIR.'}
    </p>
  </div>
</Section>

<!-- ============ AXCrew — control plane ============ -->
<Section>
  <div class="mx-auto max-w-3xl">
    <p class="kicker">{z ? 'AXCrew · 控制平面' : 'AXCrew · control plane'}</p>
    <h2 class="h2 mt-4">{z ? '再装控制平面。' : 'Then the control plane.'}</h2>
    <p class="lede mt-4">
      {z
        ? 'AXCrew 是连起这些 AX 节点的桌面端与 Android 客户端。最新发布直接从 GitHub 下载。'
        : 'AXCrew is the desktop and Android client that connects those AX nodes. Grab the latest release from GitHub.'}
    </p>

    <div class="hairline mt-8 border-line">
      <a
        href="https://github.com/Axium-Labs/AXCrew/releases/download/v0.3.0/AX-Crew-0.3.0-windows-x64-setup.exe"
        class="flex items-center justify-between gap-4 px-4 py-4 transition-colors duration-200 hover:bg-paper-2"
      >
        <span class="flex min-w-0 items-center gap-3">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-ok"></span>
          <span class="truncate font-mono text-sm text-ink">
            AXCrew — Windows x64 (.exe)
          </span>
        </span>
        <span class="mono-micro shrink-0 text-ink-3">{z ? '下载 ↓' : 'download ↓'}</span>
      </a>
      <a
        href="https://github.com/Axium-Labs/AXCrew/releases/latest"
        class="hairline-t flex items-center justify-between gap-4 border-t border-line px-4 py-3 transition-colors duration-200 hover:bg-paper-2"
      >
        <span class="mono-micro text-ink-2">{z ? '全部平台与发布说明' : 'all platforms & release notes'}</span>
        <span class="mono-micro shrink-0 text-ink-3">github.com/Axium-Labs/AXCrew →</span>
      </a>
      <a
        href="https://github.com/Axium-Labs/AXCrew"
        class="hairline-t flex items-center justify-between gap-4 border-t border-line px-4 py-3 transition-colors duration-200 hover:bg-paper-2"
      >
        <span class="mono-micro text-ink-2">{z ? '源码' : 'source'}</span>
        <span class="mono-micro shrink-0 text-ink-3">github.com/Axium-Labs/AXCrew</span>
      </a>
    </div>
  </div>
</Section>
