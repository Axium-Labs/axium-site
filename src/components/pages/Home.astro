---
/**
 * Home — one story, five movements:
 * Hero (the fleet as the signature visual) → Send work where it belongs →
 * Control every machine → Connected. Not merged. → Install.
 * No capability lists, no telemetry decoration, no repeated fleet panels.
 */
import Section from '../../components/Section.astro';
import SendWork from '../../components/SendWork.astro';
import CrewUI from '../../components/CrewUI.astro';
import Boundaries from '../../components/Boundaries.astro';
import FleetNetwork from '../../components/islands/FleetNetwork';
import InstallCommand from '../../components/islands/InstallCommand';
import { type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';
---

<!-- ============ HERO — the fleet is the visual, install is up front ============ -->
<section class="hairline-b bg-paper">
  <div class="container-x pt-16 text-center lg:pt-20">
    <p class="kicker">{z ? 'AXIUM · 代理基础设施' : 'AXIUM · agent infrastructure'}</p>
    <h1 class="display mt-5">
      {z ? (
        <>
          一个代理系统。<br />
          <span class="text-ink-3">覆盖你拥有的每一台机器。</span>
        </>
      ) : (
        <>
          One agent system.<br />
          <span class="text-ink-3">Across every machine you own.</span>
        </>
      )}
    </h1>

    <div class="container-reading mx-auto mt-7">
      <p class="lede">
        {z
          ? 'AX 在你拥有的每台机器上运行代理。AXCrew 把它们连成一体——从任意节点委派，在任意机器执行，把结果带回来。'
          : 'AX runs agents on the machines you own. AXCrew connects them — delegate from any node, run anywhere, get the result back.'}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-x-10 gap-y-3">
        <span class="datum">
          <a href={z ? '/zh/ax' : '/ax'} class="text-link">AX</a>&ensp;—&ensp;{z ? '每台机器上的代理运行时' : 'agent runtime on every node'}
        </span>
        <span class="datum">
          <a href={z ? '/zh/crew' : '/crew'} class="text-link">AXCrew</a>&ensp;—&ensp;{z ? '整支集群的控制平面' : 'control plane for the fleet'}
        </span>
      </div>
    </div>

    <!-- install — right after the lede, before the visual -->
    <div class="container-reading-wide mx-auto mt-9 text-left">
      <InstallCommand client:visible />
      <p class="datum mt-4 text-center">
        {z
          ? <>装好了？<a href="/zh/docs#cli" class="text-link">直接看 CLI</a> · <a href="/zh/download" class="text-link">下载页</a></>
          : <>already installed? <a href="/docs#cli" class="text-link">jump to the CLI</a> · <a href="/download" class="text-link">download</a></>}
      </p>
    </div>

    <!-- signature visual: the fleet, live -->
    <div class="panel-dark grid-bg mt-12">
      <div class="hairline-dark-b flex flex-wrap items-center justify-between gap-2 bg-void-2 px-4 py-2.5">
        <span class="mono-micro text-fog-2">{z ? '你的机器 · 每个节点都在运行 AX' : 'your machines · every node runs AX'}</span>
        <span class="mono-micro text-fog-2">{z ? '任务 · 路由 → 执行 → 结果' : 'task · route → execute → result'}</span>
      </div>
      <div class="p-4 sm:p-6">
        <FleetNetwork client:visible lang={lang} />
      </div>
    </div>
  </div>
</section>

<!-- ============ SEND WORK WHERE IT BELONGS ============ -->
<Section
  id="send-work"
  tone="dark"
  kicker={z ? 'send work where it belongs' : 'send work where it belongs'}
  title={z ? '一个请求。它自己去对的地方。' : 'One request. It finds the right machine.'}
  lead={z
    ? '请求从笔记本进入：代码在这里写好，构建被路由到服务器，基准测试交给 GPU 机器——结果回到发起请求的那台机器。每台机器只做自己擅长的事，AXCrew 负责搬运。'
    : 'A request enters on the laptop: code is written here, the build is routed to the server, the benchmark runs on the GPU box — and the result comes back to the machine that asked. Every machine does what it is best at; AXCrew moves the work.'}
>
  <SendWork lang={lang} />
  <p class="datum mt-8">
    {z
      ? '路由 · 出站 WSS · 设备只出站连接'
      : 'routing · outbound WSS · devices connect out only'}
  </p>
</Section>

<!-- ============ CONTROL EVERY MACHINE ============ -->
<Section
  id="control"
  kicker={z ? 'control every machine' : 'control every machine'}
  title={z ? '整个集群，装进口袋。' : 'The whole fleet, in your pocket.'}
  lead={z
    ? 'AXCrew 住在你的桌面端和手机里：一个视图看尽每个节点、每个任务、每条事件。手机观察与审批，桌面调度与排程。'
    : 'AXCrew lives on your desktop and in your phone: one view of every node, task and event. Observe and approve from the phone, schedule from the desk.'}
>
  <CrewUI lang={lang} />
</Section>

<!-- ============ CONNECTED. NOT MERGED. ============ -->
<Section
  id="boundaries"
  tone="paper2"
  kicker={z ? 'boundaries' : 'boundaries'}
  title={z ? '互联，但不合并。' : 'Connected. Not merged.'}
  lead={z
    ? '每台机器都保持自己的边界：自己的工作区、自己的沙箱、自己的权限、自己的身份。AXCrew 在它们之间路由——从不把它们合并成一个。'
    : 'Every machine keeps its own boundary: its workspace, its sandbox, its permissions, its identity. AXCrew routes between them — it never merges them.'}
>
  <Boundaries lang={lang} />
</Section>
