---
/**
 * Home — pi.dev-style editorial layout.
 *
 *   Hero      centered: headline + one-line claim + install command
 *   Then a run of paired sections: left = real output, right = why it matters
 *   Close     install + links
 *
 * Every claim is sourced from ax/docs and axcrew/docs.
 */
import InstallCommand from '../../components/islands/InstallCommand';
import ScrollSection from '../../components/ScrollSection.astro';
import TermPanel from '../../components/TermPanel.astro';
import Reveal from '../../components/Reveal.astro';
import { type Lang } from '../../lib/i18n';
import { SITE } from '../../lib/site';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';

const FEATURES = z
  ? [
      {
        title: '按验收条件推进任务',
        summary: '先说明目标和验收条件，让 AX 根据检查结果继续处理。',
        product: 'AX · Goal',
        paragraphs: [
          '例如修复一个问题时，把相关测试通过作为验收条件。开启 Goal 后，AX 执行任务并检查结果；未达到条件时，把检查发现的问题带回下一轮继续处理。',
          '可以配置命令等验证器，也可以使用模型验收。遇到需要人工处理的阻塞、暂停或达到预算限制时会停下。Goal 需要主动开启，不会在对话结束后定时唤醒。',
        ],
        panel: 'Goal',
        rows: [
          { label: '目标', value: '修复问题，并通过相关测试' },
          { label: '验收', value: '检查测试结果，未通过则继续处理' },
          { label: '控制', value: '随时查看状态、暂停或取消' },
        ],
        command: '/goal status',
        url: 'https://github.com/Axium-Labs/AX/blob/main/docs/goal.md',
      },
      {
        title: '长项目跨会话继续',
        summary: '保存项目进度和关键决策，切换会话后继续推进同一个目标。',
        product: 'AX · Long Project',
        paragraphs: [
          '长项目会维护一份工作文档，记录目标、当前进度、已完成工作、待办和关键决策。文档可以查看和编辑，也能导出或导入。',
          '主动开启 Long Project 后，可按配置自动轮换会话，也可以手动发起交接。下一段会话使用项目文档和检查点接续工作；原有会话历史仍保留。',
        ],
        panel: 'Long Project',
        rows: [
          { label: '工作文档', value: '目标、进度、待办、关键决策' },
          { label: '会话交接', value: '按配置自动轮换，或手动交接' },
          { label: '历史', value: '保留原始记录，按需查看' },
        ],
        command: '/goal project show',
        url: 'https://github.com/Axium-Labs/AX/blob/main/docs/long-project.md',
      },
      {
        title: '把工作经验整理成技能',
        summary: '从实际任务中提出可复用的做法，由你审核后试用。',
        product: 'AX + AXCrew',
        paragraphs: [
          '启用自动学习后，AX 根据本地任务执行记录整理技能候选。比如反复执行的发布步骤，可以被整理成一份供后续任务使用的技能。',
          '在 AXCrew 中查看候选技能的内容和依据，再决定接受试用或拒绝。候选不会直接变成生效技能；学习数据留在本地，不发送到 Crew 服务器。分析使用已配置的模型。',
        ],
        panel: 'Skills',
        rows: [
          { label: '来源', value: '本地实际任务的执行记录' },
          { label: '审核', value: '查看技能内容与依据，接受或拒绝' },
          { label: '使用', value: '审核通过后试用，再根据实际使用改进' },
        ],
        command: null,
        url: 'https://github.com/Axium-Labs/AX/blob/main/docs/evolution.md',
      },
      {
        title: '多台机器分工，掉线后接手',
        summary: '根据能力和机器资源安排任务，并保存检查点供后续恢复。',
        product: 'AX + AXCrew',
        paragraphs: [
          '把工作拆成有依赖关系的任务，交给已注册的 AX worker。AXCrew 根据能力和机器资源分配工作，前置任务完成后再安排后续任务，并汇总事件和产物。',
          '执行者掉线、租约到期后，任务可以重新分配。接手的机器需要可用的环境、文件和兼容配置；会话数据库与整个工作区不会自动搬过去，需要人工协调的执行状态会阻止自动恢复。',
        ],
        panel: 'AXCrew · Distributed',
        rows: [
          { label: '分工', value: '根据能力、资源与任务依赖分配工作' },
          { label: '留存', value: '任务状态、检查点、事件和发布的产物' },
          { label: '接手', value: '租约到期后，由符合条件的 AX 恢复任务' },
        ],
        command: 'ax crew worker worker.json',
        url: 'https://github.com/Axium-Labs/AXCrew/blob/main/docs/distributed-collaboration.md',
      },
    ]
  : [
      {
        title: 'Work toward acceptance criteria',
        summary: 'Define the target and its checks, then let AX continue based on the results.',
        product: 'AX · Goal',
        paragraphs: [
          'For a bug fix, you can require the relevant tests to pass. With Goal enabled, AX performs the work and checks the result. When a check fails, its findings inform the next round of work.',
          'Configure validators such as commands, or use model-based acceptance. Work stops for external blockers, a pause or an exhausted budget. Goal is opt-in and does not periodically wake a finished conversation.',
        ],
        panel: 'Goal',
        rows: [
          { label: 'Target', value: 'Fix the issue and pass the relevant tests' },
          { label: 'Acceptance', value: 'Check the results; continue if they fail' },
          { label: 'Control', value: 'Inspect status, pause or cancel' },
        ],
        command: '/goal status',
        url: 'https://github.com/Axium-Labs/AX/blob/main/docs/goal.md',
      },
      {
        title: 'Continue a long project across sessions',
        summary: 'Keep progress and decisions available when work moves to another session.',
        product: 'AX · Long Project',
        paragraphs: [
          'Long Project maintains a working document with the objective, current progress, completed work, remaining tasks and key decisions. You can inspect, edit, export and import it.',
          'Enable Long Project to use configured automatic session rotation or request a manual handoff. The next session continues with the project document and checkpoints, while earlier conversation history remains available.',
        ],
        panel: 'Long Project',
        rows: [
          { label: 'Working document', value: 'Objective, progress, tasks and decisions' },
          { label: 'Handoff', value: 'Configured rotation or a manual request' },
          { label: 'History', value: 'Original records remain available' },
        ],
        command: '/goal project show',
        url: 'https://github.com/Axium-Labs/AX/blob/main/docs/long-project.md',
      },
      {
        title: 'Turn experience into reusable skills',
        summary: 'Review approaches proposed from actual work before trying them on later tasks.',
        product: 'AX + AXCrew',
        paragraphs: [
          'With automatic learning enabled, AX uses local task execution records to propose skills. Repeated release steps, for example, can become instructions for future tasks.',
          'Inspect each proposed skill and its evidence in AXCrew, then accept it for trial or reject it. Candidates do not become usable skills without review. Learning data stays local to AX rather than going to the Crew server; analysis uses your configured model.',
        ],
        panel: 'Skills',
        rows: [
          { label: 'Source', value: 'Records from actual local tasks' },
          { label: 'Review', value: 'Inspect instructions and evidence; accept or reject' },
          { label: 'Use', value: 'Trial after review, then refine from actual use' },
        ],
        command: null,
        url: 'https://github.com/Axium-Labs/AX/blob/main/docs/evolution.md',
      },
      {
        title: 'Distribute work and recover after a disconnect',
        summary: 'Assign tasks by capabilities and machine resources, with checkpoints for recovery.',
        product: 'AX + AXCrew',
        paragraphs: [
          'Define tasks and their dependencies for enrolled AX workers. AXCrew assigns work by capabilities and machine resources, schedules dependent tasks after their prerequisites finish, and collects events and artifacts.',
          'If a worker disconnects and its lease expires, the task can be reassigned. Recovery requires the right environment, files and compatible configuration. Session databases and entire workspaces are not transferred automatically; states requiring reconciliation block automatic recovery.',
        ],
        panel: 'AXCrew · Distributed',
        rows: [
          { label: 'Assignment', value: 'Capabilities, resources and task dependencies' },
          { label: 'Persistence', value: 'Task state, checkpoints, events and published artifacts' },
          { label: 'Recovery', value: 'An eligible AX resumes after the lease expires' },
        ],
        command: 'ax crew worker worker.json',
        url: 'https://github.com/Axium-Labs/AXCrew/blob/main/docs/distributed-collaboration.md',
      },
    ];

---

<!-- ════════════════ HERO — centred, like pi.dev ════════════════ -->
<section class="relative overflow-hidden border-b border-[var(--color-border)]">
  <!-- faint grid texture, faded at the edges -->
  <div class="grid-bg grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="container-x relative pb-20 pt-12 text-center md:pb-28 md:pt-16">
    <Reveal>
      <p class="label mb-7 block">
        {z ? 'AX · AXCrew' : 'AX · AXCrew'}
      </p>
    </Reveal>

    <Reveal delay={60}>
      <h1 class="display-serif-lg mx-auto max-w-[20ch] text-balance">
        {
          z ? (
            <>终端里的 AI 助手，<br /><span class="text-[var(--color-text-3)]">和它的桌面工作台。</span></>
          ) : (
            <>An AI agent for your terminal.<br /><span class="text-[var(--color-text-3)]">A desktop app to work with it.</span></>
          )
        }
      </h1>
    </Reveal>

    <Reveal delay={120}>
      <p class="mx-auto mt-7 max-w-[46ch] text-[1.0625rem] leading-relaxed text-[var(--color-text-2)]">
        {
          z
            ? <>AX 负责读写文件、执行命令和调用工具。<br />AXCrew 提供聊天、文件审查、网页预览和多机器管理。</>
            : <>AX reads and edits files, runs commands and uses tools.<br />AXCrew adds chat, file review, web preview and multi-machine management.</>
        }
      </p>
    </Reveal>

    <Reveal delay={180}>
      <div class="mx-auto mt-10 max-w-[42rem] text-left">
        <InstallCommand client:visible lang={lang} />
      </div>
    </Reveal>

    <Reveal delay={240}>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
        <a href={z ? '/zh/ax' : '/ax'} class="datum text-link">AX {SITE.axVersion} →</a>
        <a href={z ? '/zh/crew' : '/crew'} class="datum text-link">AXCrew {SITE.crewVersion} →</a>
        <a href={z ? '/zh/docs' : '/docs'} class="datum text-link">{z ? '文档' : 'docs'} →</a>
      </div>
    </Reveal>
  </div>
</section>

<!-- Product use cases -->
<section class="border-b border-[var(--color-border)]">
  <div class="container-x section-y">
    <Reveal>
      <h2 class="display-serif max-w-[24ch] text-balance">
        {z ? '用 AX 和 AXCrew 持续推进工作' : 'Working with AX and AXCrew'}
      </h2>
      <p class="mt-6 max-w-[55ch] text-[1.0625rem] leading-relaxed text-[var(--color-text-2)]">
        {z
          ? 'AX 可以单独在终端中使用。安装 AXCrew 后，可以在桌面端与 AX 对话，也可以连接其他机器上的 AX。'
          : 'Use AX on its own in the terminal. Install AXCrew for a desktop interface and connections to AX on other machines.'}
      </p>
    </Reveal>
    <div class="mt-12 grid gap-x-14 md:grid-cols-2">
      {FEATURES.map((item, i) => (
        <Reveal delay={(i % 2) * 70}>
          <div class="border-t border-[var(--color-border)] py-7">
            <p class="label mb-3">{item.product}</p>
            <h3 class="font-display text-[1.375rem] leading-snug tracking-[-0.01em] text-[var(--color-text)]">{item.title}</h3>
            <p class="mt-3 max-w-[48ch] text-[0.9375rem] leading-relaxed text-[var(--color-text-2)]">{item.summary}</p>
          </div>
        </Reveal>
      ))}
    </div>
    <div class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
      <a href={z ? '/zh/ax' : '/ax'} class="datum text-link">{z ? '了解 AX' : 'Explore AX'} →</a>
      <a href={z ? '/zh/crew' : '/crew'} class="datum text-link">{z ? '了解 AXCrew' : 'Explore AXCrew'} →</a>
    </div>
  </div>
</section>

<!-- Four product capabilities -->
{FEATURES.map((feature, index) => (
  <ScrollSection
    flip={index % 2 === 1}
    kicker={`${String(index + 1).padStart(2, '0')} · ${feature.product}`}
    title={feature.title}
  >
    <TermPanel slot="demo" title={feature.panel}>
      <p class="mb-5 text-[var(--color-void-text-2)]">{z ? '工作方式' : 'How it works'}</p>
      <dl class="space-y-5">
        {feature.rows.map((row) => (
          <div>
            <dt class="text-[var(--color-void-text-2)]">{row.label}</dt>
            <dd class="mt-1">{row.value}</dd>
          </div>
        ))}
      </dl>
      {feature.command && (
        <div class="mt-5 border-t border-[var(--color-void-border)] pt-4">
          <p class="mb-2 text-[var(--color-void-text-2)]">{z ? '命令示例' : 'Example command'}</p>
          <code class="block overflow-x-auto whitespace-pre">{feature.command}</code>
        </div>
      )}
    </TermPanel>
    <div slot="body">
      {feature.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <a slot="cta" href={feature.url} class="datum text-link mt-6 inline-block">
      {z ? '使用说明' : 'Usage documentation'} →
    </a>
  </ScrollSection>
))}

<section class="border-b border-[var(--color-border)]">
  <div class="container-x py-12">
    <p class="max-w-3xl text-[0.9375rem] leading-relaxed text-[var(--color-text-2)]">
      {z
        ? '也支持多家模型提供方、Skills 和 MCP。AXCrew 提供文件变更审查和网页预览；本地 Windows AX 可直接操作预览页，其他桌面平台目前支持普通预览。'
        : 'AX also supports multiple model providers, skills and MCP. AXCrew includes file change review and web preview. Local Windows AX can control preview pages; other desktop platforms currently support user preview.'}
    </p>
    <a href={z ? '/zh/crew' : '/crew'} class="datum text-link mt-4 inline-block">{z ? '查看 AXCrew 功能' : 'See AXCrew features'} →</a>
  </div>
</section>

<!-- ════════════════ CLOSE ════════════════ -->
<section>
  <div class="container-x py-24 text-center md:py-32">
    <Reveal>
      <h2 class="display-serif mx-auto max-w-[18ch] text-balance">
        {z ? <>安装 AX</> : <>Install AX</>}
      </h2>
      <p class="mx-auto mt-6 max-w-[44ch] text-[1.0625rem] leading-relaxed text-[var(--color-text-2)]">
        {
          z
            ? '支持 Windows、Linux 和 macOS。安装后运行 ax，登录模型提供方即可开始。'
            : 'Available for Windows, Linux and macOS. After installation, run ax and sign in to a model provider.'
        }
      </p>
      <div class="mx-auto mt-10 max-w-[42rem] text-left">
        <InstallCommand client:visible lang={lang} />
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
        <a href={z ? '/zh/ax' : '/ax'} class="datum text-link">AX →</a>
        <a href={z ? '/zh/crew' : '/crew'} class="datum text-link">AXCrew →</a>
        <a href={z ? '/zh/docs' : '/docs'} class="datum text-link">{z ? '文档 →' : 'docs →'}</a>
      </div>
    </Reveal>
  </div>
</section>
