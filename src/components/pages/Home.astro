---
/**
 * Home — pi.dev-style editorial layout.
 *
 *   Hero      centered: headline + one-line claim + install command
 *   Then a run of paired sections: left = real output, right = why it matters
 *   Close     install + links
 *
 * Every claim is sourced from ax/docs and axcrew/docs.
 */
import InstallCommand from '../../components/islands/InstallCommand';
import ScrollSection from '../../components/ScrollSection.astro';
import TermPanel from '../../components/TermPanel.astro';
import Reveal from '../../components/Reveal.astro';
import { type Lang } from '../../lib/i18n';
import { SITE } from '../../lib/site';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';

const USE_CASES = z
  ? [
      {
        title: '用 AX 处理项目里的工作',
        body: '在终端里让 AX 阅读代码、修改文件、执行命令。会话会保存，也可以在 AXCrew 中打开，查看文件和变更。',
        product: 'AX + AXCrew',
      },
      {
        title: '选择模型，接入工具',
        body: '支持多家模型提供方，可用 API Key 或 OAuth 登录。技能用来保存常用任务的做法，MCP 用来连接外部工具。',
        product: 'AX',
      },
      {
        title: '在聊天旁边查看网页',
        body: 'AXCrew 提供网页预览和文件变更审查。本地 Windows AX 可以直接读取、点击和填写预览页面；其他桌面平台目前支持普通预览。',
        product: 'AXCrew',
      },
      {
        title: '管理多台机器上的 AX',
        body: '在 AXCrew 中分配任务、查看进度、处理审批。分布式任务会保存检查点；执行任务的 AX 掉线后，另一台满足要求的 AX 可以接手。',
        product: 'AX + AXCrew',
      },
    ]
  : [
      {
        title: 'Work on your project with AX',
        body: 'Ask AX to read code, edit files and run commands from your terminal. Conversations are saved, and you can also open them in AXCrew to review files and changes.',
        product: 'AX + AXCrew',
      },
      {
        title: 'Choose models and connect tools',
        body: 'Connect to supported model providers with an API key or OAuth. Use skills for recurring tasks and MCP to connect external tools.',
        product: 'AX',
      },
      {
        title: 'Preview pages alongside chat',
        body: 'AXCrew includes web preview and file change review. Local Windows AX can read, click and fill preview pages. Other desktop platforms currently support user preview.',
        product: 'AXCrew',
      },
      {
        title: 'Manage AX across machines',
        body: 'Assign tasks, follow progress and handle approvals in AXCrew. Distributed tasks save checkpoints so another AX with the required capabilities and resources can take over if a worker goes offline.',
        product: 'AX + AXCrew',
      },
    ];


---

<!-- ════════════════ HERO — centred, like pi.dev ════════════════ -->
<section class="relative overflow-hidden border-b border-[var(--color-border)]">
  <!-- faint grid texture, faded at the edges -->
  <div class="grid-bg grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="container-x relative pb-20 pt-12 text-center md:pb-28 md:pt-16">
    <Reveal>
      <p class="label mb-7 block">
        {z ? 'AX · AXCrew' : 'AX · AXCrew'}
      </p>
    </Reveal>

    <Reveal delay={60}>
      <h1 class="display-serif-lg mx-auto max-w-[20ch] text-balance">
        {
          z ? (
            <>终端里的 AI 助手，<br /><span class="text-[var(--color-text-3)]">和它的桌面工作台。</span></>
          ) : (
            <>An AI agent for your terminal.<br /><span class="text-[var(--color-text-3)]">A desktop app to work with it.</span></>
          )
        }
      </h1>
    </Reveal>

    <Reveal delay={120}>
      <p class="mx-auto mt-7 max-w-[46ch] text-[1.0625rem] leading-relaxed text-[var(--color-text-2)]">
        {
          z
            ? <>AX 负责读写文件、执行命令和调用工具。<br />AXCrew 提供聊天、文件审查、网页预览和多机器管理。</>
            : <>AX reads and edits files, runs commands and uses tools.<br />AXCrew adds chat, file review, web preview and multi-machine management.</>
        }
      </p>
    </Reveal>

    <Reveal delay={180}>
      <div class="mx-auto mt-10 max-w-[42rem] text-left">
        <InstallCommand client:visible lang={lang} />
      </div>
    </Reveal>

    <Reveal delay={240}>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
        <a href={z ? '/zh/ax' : '/ax'} class="datum text-link">AX {SITE.axVersion} →</a>
        <a href={z ? '/zh/crew' : '/crew'} class="datum text-link">AXCrew {SITE.crewVersion} →</a>
        <a href={z ? '/zh/docs' : '/docs'} class="datum text-link">{z ? '文档' : 'docs'} →</a>
      </div>
    </Reveal>
  </div>
</section>

<!-- Product use cases -->
<section class="border-b border-[var(--color-border)]">
  <div class="container-x section-y">
    <Reveal>
      <h2 class="display-serif max-w-[24ch] text-balance">
        {z ? 'AX 和 AXCrew 能做什么' : 'What AX and AXCrew do'}
      </h2>
      <p class="mt-6 max-w-[55ch] text-[1.0625rem] leading-relaxed text-[var(--color-text-2)]">
        {z
          ? 'AX 可以单独在终端中使用。安装 AXCrew 后，可以在桌面端与 AX 对话，也可以连接其他机器上的 AX。'
          : 'Use AX on its own in the terminal. Install AXCrew for a desktop interface and connections to AX on other machines.'}
      </p>
    </Reveal>
    <div class="mt-12 grid gap-x-14 md:grid-cols-2">
      {USE_CASES.map((item, i) => (
        <Reveal delay={(i % 2) * 70}>
          <div class="border-t border-[var(--color-border)] py-7">
            <p class="label mb-3">{item.product}</p>
            <h3 class="font-display text-[1.375rem] leading-snug tracking-[-0.01em] text-[var(--color-text)]">{item.title}</h3>
            <p class="mt-3 max-w-[48ch] text-[0.9375rem] leading-relaxed text-[var(--color-text-2)]">{item.body}</p>
          </div>
        </Reveal>
      ))}
    </div>
    <div class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
      <a href={z ? '/zh/ax' : '/ax'} class="datum text-link">{z ? '了解 AX' : 'Explore AX'} →</a>
      <a href={z ? '/zh/crew' : '/crew'} class="datum text-link">{z ? '了解 AXCrew' : 'Explore AXCrew'} →</a>
    </div>
  </div>
</section>

<!-- ════════════════ 01 · DURABILITY ════════════════ -->
<ScrollSection
  kicker={z ? '01 · 会话' : '01 · sessions'}
  title={z ? '保存和继续会话' : 'Save and continue conversations'}
>
  <TermPanel slot="demo" title="ax · session" meta={z ? '命令示例' : 'example commands'}>
    <p class="mb-3 text-[var(--color-void-text-2)]">{z ? '继续已有会话' : 'Continue a saved conversation'}</p>
    <p>$ ax run --session &lt;id&gt; "keep going"</p>
    <div class="mt-5 border-t border-[var(--color-void-border)] pt-4">
      <p class="mb-3 text-[var(--color-void-text-2)]">{z ? '导出备份，检查待导入内容' : 'Export a backup and inspect it before import'}</p>
      <p>$ ax export backup.axpack</p>
      <p class="mt-2">$ ax import backup.axpack --dry-run</p>
    </div>
  </TermPanel>

  <div slot="body">
    <p>
      {
        z
          ? <>消息和工具结果保存在本地。重新打开历史会话，可以查看已有记录，再继续处理同一个项目。</>
          : <>Messages and tool results are saved locally. Reopen a conversation to review its history and continue working on the same project.</>
      }
    </p>
    <p>
      {
        z
          ? <>可以导出会话和记忆作为备份。导入前先检查内容和冲突，再决定是否合并。</>
          : <>Export conversations and memory as a backup. Inspect the backup and any conflicts before importing it.</>
      }
    </p>
    <p>
      {
        z
          ? <>默认数据保存在安装目录的 <code class="chip">.ax</code> 下，各项目分别存储。删除项目文件夹不会同时删除会话历史。</>
          : <>Data is saved under <code class="chip">.ax</code> in the install directory by default, with separate project stores. Deleting a project folder does not delete its conversation history.</>
      }
    </p>
  </div>
</ScrollSection>

<!-- ════════════════ 02 · SKILLS, MCP, MEMORY ════════════════ -->
<ScrollSection
  flip
  kicker={z ? '02 · 能力' : '02 · capabilities'}
  title={z ? '添加技能和外部工具' : 'Add skills and external tools'}
>
  <TermPanel slot="demo" title="ax · skills & tools">
    <div class="space-y-5">
      <div><p>SKILL.md</p><p class="mt-1 text-[var(--color-void-text-2)]">{z ? '任务说明与配套资源' : 'Task instructions and resources'}</p></div>
      <div><p>MCP</p><p class="mt-1 text-[var(--color-void-text-2)]">{z ? '连接外部工具' : 'Connections to external tools'}</p></div>
      <div><p>{z ? '项目设置' : 'Project settings'}</p><p class="mt-1 text-[var(--color-void-text-2)]">{z ? '为不同项目选择不同的技能和工具' : 'Choose skills and tools for each project'}</p></div>
    </div>
  </TermPanel>

  <div slot="body">
    <p>
      {
        z
          ? <>把常用任务的说明和资源整理成 <code class="chip">SKILL.md</code> 技能包，供 AX 在相关任务中使用。</>
          : <>Package instructions and resources for recurring tasks in a <code class="chip">SKILL.md</code> skill that AX can use when relevant.</>
      }
    </p>
    <p>
      {
        z
          ? <>通过 MCP 接入外部工具。配置好服务器后，AX 可以在任务中调用它提供的工具。</>
          : <>Connect external tools through MCP. Once a server is configured, AX can call the tools it provides during a task.</>
      }
    </p>
    <p>
      {
        z
          ? <>技能、MCP 和记忆可以按项目管理，也可以设置为全局使用。项目设置可以覆盖全局设置。</>
          : <>Manage skills, MCP and memory per project or globally. Project settings can override global settings.</>
      }
    </p>
  </div>
</ScrollSection>

<!-- ════════════════ 03 · PROVIDERS ════════════════ -->
<ScrollSection
  kicker={z ? '03 · 模型' : '03 · models'}
  title={z ? '使用不同的模型' : 'Use different models'}
>
  <TermPanel slot="demo" title="ax · /model" meta={z ? '部分支持的提供方' : 'selected providers'}>
    <div class="space-y-1">
      <p class="text-[var(--color-void-text-2)]">{z ? '模型提供方与登录方式' : 'Providers and sign-in options'}</p>
      <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1">
        <p>Anthropic</p>
        <p>OpenAI-compatible</p>
        <p>Gemini</p>
        <p>Vertex</p>
        <p>Bedrock</p>
        <p>Codex OAuth</p>
        <p>WorkBuddy</p>
        <p class="text-[var(--color-void-text-2)]">local models…</p>
      </div>
    </div>
    <p class="mt-3 border-t border-[var(--color-void-border)] pt-3 text-[var(--color-void-text-2)]">
      /model provider/model-id
    </p>
  </TermPanel>

  <div slot="body">
    <p>
      {
        z
          ? <>支持 DeepSeek、OpenAI、Anthropic、Gemini 等模型提供方，以及 Codex 和 WorkBuddy 登录。可用模型取决于已配置的账号与服务。</>
          : <>Supported providers include DeepSeek, OpenAI, Anthropic and Gemini, with sign-in options for Codex and WorkBuddy. Available models depend on your accounts and configured services.</>
      }
    </p>
    <p>
      {
        z
          ? <>在会话中用 <code class="chip">/model</code> 选择模型。所选模型和推理强度会保存，下次启动时恢复。</>
          : <>Use <code class="chip">/model</code> to choose a model during a conversation. Your model and reasoning-effort selection are saved for the next launch.</>
      }
    </p>
    <p>
      {
        z
          ? <>也可以配置 OpenAI 兼容服务的地址，接入对应的托管或本地模型。</>
          : <>You can also configure an OpenAI-compatible endpoint for hosted or local models.</>
      }
    </p>
  </div>
</ScrollSection>

<!-- ════════════════ 04 · AXCREW ════════════════ -->
<ScrollSection
  flip
  kicker={z ? '04 · 控制平面' : '04 · control plane'}
  title={z ? '连接其他机器上的 AX' : 'Connect AX on other machines'}
>
  <TermPanel slot="demo" title="ax crew" meta={z ? '连接命令' : 'connection commands'}>
    <p class="mb-3 text-[var(--color-void-text-2)]">{z ? '在目标机器上配对 AX' : 'Pair AX on the target machine'}</p>
    <p>$ ax crew pair &lt;code&gt; --gateway &lt;url&gt;</p>
    <p class="mb-3 mt-5 text-[var(--color-void-text-2)]">{z ? '连接到 Crew 网关' : 'Connect to the Crew gateway'}</p>
    <p>$ ax crew connect &lt;url&gt;</p>
  </TermPanel>

  <div slot="body">
    <p>
      {
        z
          ? <>在另一台机器上安装 AX，用配对码连接到 AXCrew，就可以从桌面端查看会话、发送任务和处理审批。</>
          : <>Install AX on another machine and pair it with AXCrew to view conversations, send tasks and handle approvals from the desktop app.</>
      }
    </p>
    <p>
      {
        z
          ? <>配对设备主动连接 Crew 网关，不需要为每台 AX 机器开放入站端口。远程连接需要可访问的 HTTPS/WSS 网关。</>
          : <>Paired devices connect to the Crew gateway without opening inbound ports on each AX machine. Remote connections need a reachable HTTPS/WSS gateway.</>
      }
    </p>
    <p>
      {
        z
          ? <>每台机器保留自己的模型配置、凭据、技能和记忆。需要多机协作时，还可以注册分布式 worker，由 Crew 分配工作并保存任务检查点。</>
          : <>Each machine keeps its own model configuration, credentials, skills and memory. For distributed work, register workers so Crew can assign tasks and retain checkpoints.</>
      }
    </p>
  </div>
</ScrollSection>

<!-- ════════════════ CLOSE ════════════════ -->
<section>
  <div class="container-x py-24 text-center md:py-32">
    <Reveal>
      <h2 class="display-serif mx-auto max-w-[18ch] text-balance">
        {z ? <>安装 AX</> : <>Install AX</>}
      </h2>
      <p class="mx-auto mt-6 max-w-[44ch] text-[1.0625rem] leading-relaxed text-[var(--color-text-2)]">
        {
          z
            ? '支持 Windows、Linux 和 macOS。安装后运行 ax，登录模型提供方即可开始。'
            : 'Available for Windows, Linux and macOS. After installation, run ax and sign in to a model provider.'
        }
      </p>
      <div class="mx-auto mt-10 max-w-[42rem] text-left">
        <InstallCommand client:visible lang={lang} />
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-2">
        <a href={z ? '/zh/ax' : '/ax'} class="datum text-link">AX →</a>
        <a href={z ? '/zh/crew' : '/crew'} class="datum text-link">AXCrew →</a>
        <a href={z ? '/zh/docs' : '/docs'} class="datum text-link">{z ? '文档 →' : 'docs →'}</a>
      </div>
    </Reveal>
  </div>
</section>
