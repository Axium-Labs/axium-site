---
/**
 * AX page — four themes only: run anywhere, connect to the fleet,
 * execute locally, keep state local. Capabilities, providers and the
 * CLI reference live in the docs.
 */
import Section from '../../components/Section.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../lib/site';
import { b, type B, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';

const CONNECT_CMDS = [
  { cmd: 'ax crew pair <code> --gateway <url>', out: b('pair a device · Ed25519 challenge', '配对设备 · Ed25519 挑战') },
  { cmd: 'ax crew connect <url>', out: b('outbound WSS · auto-reconnect', '出站 WSS · 自动重连') },
  { cmd: 'axcrew up', out: b('start the control plane', '启动控制平面') },
] as const;

const LOCAL_STEPS: B[] = [
  b('plan · one loop, no second planner', '规划 · 一条循环，没有第二个规划器'),
  b('act · tools run on this machine', '执行 · 工具在这台机器上运行'),
  b('verify · results checkpointed', '验证 · 结果全部断点'),
  b('resume · never re-runs done work', '恢复 · 绝不重跑已完成的工作'),
];

const STATE_ROWS: { name: B; body: B }[] = [
  {
    name: b('History & memory', '历史与记忆'),
    body: b('Sessions, memory and credentials stay on the machine that owns them. AXCrew sees redacted metadata only.', '会话、记忆与凭据留在拥有它们的那台机器上。AXCrew 只能看到脱敏后的元数据。'),
  },
  {
    name: b('Checkpoints', '断点'),
    body: b('Every result is checkpointed before execution advances. Suspend, resume, supersede — work is never lost.', '每次结果都在执行推进前完成断点。挂起、恢复、取代——工作永不丢失。'),
  },
  {
    name: b('Backup', '备份'),
    body: b('ax export / ax import carry a full axpack between machines.', 'ax export / ax import 把完整的 axpack 在机器之间迁移。'),
  },
  {
    name: b('Keys', '密钥'),
    body: b('Device identity is Ed25519. Private keys never leave the device.', '设备身份是 Ed25519。私钥永不离开设备。'),
  },
];
---

<PageHero
  kicker={z ? 'AX · 代理运行时' : 'AX · agent runtime'}
  title={z ? '代理真正干活的地方。' : 'The runtime where agents work.'}
  lead={z
    ? 'AX 是一台机器上的代理运行时：一个二进制，本地执行，能加入由 AXCrew 连接的集群。能力细节在文档里——这里只讲它在哪里跑、如何连接、如何守住边界。'
    : 'AX is the agent runtime on a machine: one binary, local execution, able to join a fleet connected by AXCrew. The capability details live in the docs — here is where it runs, how it connects, and how it keeps its boundary.'}
  meta={[`v${SITE.axVersion}`, 'rust · single static binary', z ? '本地优先 · 提供方中立' : 'local first · provider-neutral', z ? '断点 · 可恢复' : 'checkpointed · resumable']}
/>

<!-- ============ 01 CONNECT TO FLEET ============ -->
<Section
  id="connect-fleet"
  tone="dark"
  kicker={z ? '01 — connect to the fleet' : '01 — connect to the fleet'}
  title={z ? '加入集群，只需要一次配对。' : 'Join the fleet with one pairing.'}
  lead={z
    ? 'AXCrew 是控制平面；每台 AX 设备通过出站连接加入它。没有入站端口，没有 SSH，没有私钥离开设备。'
    : 'AXCrew is the control plane; every AX device joins it over an outbound connection. No inbound port, no SSH, no private key leaving the device.'}
>
  <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
    <div class="panel-dark grid-bg">
      <div class="hairline-dark-b bg-void-2 px-4 py-2.5">
        <span class="mono-micro text-fog-2">{z ? 'CLI · 命令保持英文' : 'cli · commands stay english'}</span>
      </div>
      <div class="space-y-5 p-5 sm:p-6">
        {
          CONNECT_CMDS.map((c) => (
            <div>
              <code class="term text-fog">$ {c.cmd}</code>
              <p class="mono-micro mt-1 text-fog-2">{c.out[lang]}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class="space-y-4">
      {
        [
          b('One-time pairing code + Ed25519 challenge', '一次性配对码 + Ed25519 挑战'),
          b('Outbound WSS with heartbeats and backoff', '带心跳与退避的出站 WSS'),
          b('Disconnect marks offline · resume on reconnect', '断线标记离线 · 重连即恢复'),
          b('AXCrew never reaches into agent state', 'AXCrew 从不伸进代理状态'),
        ].map((t) => (
          <p class="hairline-b border-b border-line-dark pb-3 font-mono text-[0.8125rem] text-fog-2">{t[lang]}</p>
        ))
      }
    </div>
  </div>
</Section>

<!-- ============ 02 EXECUTE LOCALLY ============ -->
<Section
  id="execute-locally"
  kicker={z ? '02 — execute locally' : '02 — execute locally'}
  title={z ? '循环在机器上运行。' : 'The loop runs on the machine.'}
  lead={z
    ? 'AX 的代理循环——规划、调用工具、验证、断点——全部在这台机器上发生。子代理在同一台机器上隔离执行；沙箱是工具之下的操作系统边界。'
    : 'AX\u2019s agent loop — plan, call tools, verify, checkpoint — happens entirely on this machine. Subagents run isolated on the same machine; a sandbox sits under every tool.'}
>
  <div class="hairline border-line">
    {
      LOCAL_STEPS.map((s, i) => (
        <div class="flex items-baseline gap-4 border-b border-line px-4 py-4 last:border-b-0 sm:px-5">
          <span class="mono-micro shrink-0 tabular-nums text-ink-3">{String(i + 1).padStart(2, '0')}</span>
          <span class="font-mono text-[0.8125rem] text-ink">{s[lang]}</span>
        </div>
      ))
    }
  </div>
</Section>

<!-- ============ 03 KEEP STATE LOCAL ============ -->
<Section
  id="keep-state-local"
  tone="paper2"
  kicker={z ? '03 — keep state local' : '03 — keep state local'}
  title={z ? '状态留在它所属的机器上。' : 'State stays where it belongs.'}
  lead={z
    ? '历史、记忆、凭据、密钥——都留在本地。AXCrew 路由任务和流式事件，但它从不触碰代理状态。'
    : 'History, memory, credentials, keys — all stay local. AXCrew routes tasks and streams events; it never touches agent state.'}
>
  <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2">
    {
      STATE_ROWS.map((r) => (
        <div class="bg-paper-2 p-6">
          <p class="font-mono text-[0.8125rem] font-medium tracking-[-0.01em] text-ink">{r.name[lang]}</p>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-2">{r.body[lang]}</p>
        </div>
      ))
    }
  </div>
  <p class="datum mt-8">
    {z
      ? '工具、技能、MCP、记忆、子代理、沙箱、提供方、CLI——完整参考在文档里。'
      : 'Tools, skills, MCP, memory, subagents, sandbox, providers, CLI — the full reference is in the docs.'}
  </p>
</Section>
