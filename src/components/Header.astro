---
import { NAV } from '../lib/site';
import { altPath, LANG_LABEL, localized, routeOf, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const path = Astro.url.pathname;
const route = routeOf(path);

const isActive = (href: string) => route !== '/' && route.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-sm">
  <div class="container-x flex h-14 items-center justify-between gap-8">
    <div class="flex items-center gap-8">
      <a
        href={lang === 'zh' ? '/zh' : '/'}
        class="flex shrink-0 items-center gap-2"
        aria-label="AXIUM home"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" class="text-[var(--color-text)]">
          <g fill="currentColor">
            <rect x="2" y="0" width="2" height="2"></rect>
            <rect x="6" y="0" width="2" height="2"></rect>
            <rect x="1" y="1" width="6" height="1"></rect>
            <rect x="2" y="2" width="4" height="1"></rect>
            <rect x="1" y="3" width="6" height="3"></rect>
            <rect x="0" y="4" width="8" height="2"></rect>
            <rect x="2" y="6" width="4" height="1"></rect>
          </g>
          <g fill="var(--color-bg)">
            <rect x="3" y="3" width="1" height="1"></rect>
            <rect x="6" y="3" width="1" height="1"></rect>
          </g>
        </svg>
        <span class="font-mono text-[0.8125rem] font-medium tracking-[0.06em] uppercase text-[var(--color-text)]">AXIUM</span>
      </a>

      <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
        {
          NAV.map((n) => (
            <a
              href={localized(n.href, lang)}
              class="nav-link"
              aria-current={isActive(n.href) ? 'page' : undefined}
            >
              {n.label[lang]}
            </a>
          ))
        }
      </nav>
    </div>

    <nav class="flex shrink-0 items-center gap-1.5 font-mono text-[11px]" aria-label="Language">
      {
        (['en', 'zh'] as const).map((l, i) => (
          <>
            {i === 1 && <span class="text-[var(--color-border-strong)]" aria-hidden="true">/</span>}
            {l === lang ? (
              <span class="font-medium text-[var(--color-text)]" aria-current="true" lang={l}>
                {LANG_LABEL[l]}
              </span>
            ) : (
              <a
                href={altPath(path, l)}
                class="text-[var(--color-text-3)] transition-colors duration-150 hover:text-[var(--color-text)]"
                lang={l}
              >
                {LANG_LABEL[l]}
              </a>
            )}
          </>
        ))
      }
    </nav>
  </div>

  <!-- mobile nav -->
  <div class="no-scrollbar overflow-x-auto border-t border-[var(--color-border)] md:hidden">
    <nav class="container-x flex items-center gap-6 py-2.5" aria-label="Main mobile">
      {
        NAV.map((n) => (
          <a
            href={localized(n.href, lang)}
            class="nav-link whitespace-nowrap"
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label[lang]}
          </a>
        ))
      }
    </nav>
  </div>
</header>
