---
/**
 * Reveal — progressive scroll entrance animation.
 *
 * Content is VISIBLE by default (no layout shift, no blank page).
 * When JS runs and IntersectionObserver fires, the animation replays.
 * prefers-reduced-motion: animation is skipped entirely.
 */
interface Props {
  delay?: number;
  from?: 'up' | 'left' | 'right' | 'none';
  as?: string;
  class?: string;
}

const { delay = 0, from = 'up', as = 'div', class: className = '' } = Astro.props;
const Tag = as as any;

const offsets: Record<string, string> = {
  up:    '0, 1.25rem',
  left:  '-1.25rem, 0',
  right: '1.25rem, 0',
  none:  '0, 0',
};
---

<Tag
  class:list={['reveal-host', className]}
  data-reveal
  data-from={from}
  data-delay={delay}
>
  <slot />
</Tag>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .reveal-host.reveal-armed {
      opacity: 0;
      transition:
        opacity 600ms cubic-bezier(0.22, 0.61, 0.36, 1),
        translate 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .reveal-host.reveal-armed[data-from="up"]    { translate: 0 1.25rem; }
    .reveal-host.reveal-armed[data-from="left"]  { translate: -1.25rem 0; }
    .reveal-host.reveal-armed[data-from="right"] { translate: 1.25rem 0; }
    .reveal-host.reveal-armed[data-from="none"]  { translate: 0 0; }

    .reveal-host.reveal-armed.reveal-in {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>

<script>
  function initReveal() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!items.length) return;

    // Step 1: arm all items (set them invisible) only after a frame,
    // so the page never flashes blank on load.
    requestAnimationFrame(() => {
      items.forEach((el) => {
        el.classList.add('reveal-armed');
        const d = el.dataset.delay;
        if (d && d !== '0') {
          el.style.transitionDelay = `${d}ms`;
        }
      });

      // Step 2: immediately reveal anything already in viewport
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('reveal-in');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -4% 0px' },
      );

      items.forEach((el) => observer.observe(el));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveal, { once: true });
  } else {
    initReveal();
  }

  document.addEventListener('astro:page-load', initReveal);
</script>
