---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
  meta?: string[];
}

const { kicker, title, lead, meta } = Astro.props;
---

<section class="hairline-b bg-paper">
  <div class="container-x section-pad">
    <p class="kicker">{kicker}</p>
    <h1 class="display mt-5 max-w-4xl">{title}</h1>
    {lead && <p class="lede mt-7 max-w-2xl">{lead}</p>}
    {meta && (
      <div class="mt-10 flex flex-wrap gap-x-10 gap-y-2 hairline-t pt-6">
        {meta.map((m) => (
          <span class="datum">{m}</span>
        ))}
      </div>
    )}
  </div>
</section>
