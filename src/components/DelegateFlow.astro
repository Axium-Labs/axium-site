---
/**
 * DelegateFlow — the delegate scene (dark section, no JS):
 * a task leaves the laptop, AXCrew routes it to the GPU box,
 * the result comes back. Outbound edges forward, result edges back.
 */

const W = 760;
const H = 300;

const laptop = { x: 60, y: 90 };
const hub = { x: W / 2, y: 90 };
const gpu = { x: W - 60, y: 90 };

const boxW = 150;
const boxH = 44;
---

<svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Task delegation between laptop and GPU server via AXCrew">
  <!-- nodes -->
  <g>
    <rect x={laptop.x - boxW / 2} y={laptop.y - boxH / 2} width={boxW} height={boxH} fill="var(--color-void-2)" stroke="var(--color-line-dark)" />
    <text x={laptop.x} y={laptop.y - 2} text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="var(--color-fog)">laptop</text>
    <text x={laptop.x} y={laptop.y + 14} text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-fog-2)">ax-01 · dev</text>

    <rect x={hub.x - boxW / 2} y={hub.y - boxH / 2} width={boxW} height={boxH} fill="var(--color-void-2)" stroke="var(--color-fog)" />
    <text x={hub.x} y={hub.y} text-anchor="middle" font-family="var(--font-mono)" font-size="13" font-weight="500" fill="var(--color-fog)">AXCrew</text>
    <text x={hub.x} y={hub.y + 14} text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-fog-2)">control plane</text>

    <rect x={gpu.x - boxW / 2} y={gpu.y - boxH / 2} width={boxW} height={boxH} fill="var(--color-void-2)" stroke="var(--color-line-dark)" />
    <text x={gpu.x} y={gpu.y - 2} text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="var(--color-fog)">gpu-box</text>
    <text x={gpu.x} y={gpu.y + 14} text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-fog-2)">ax-03 · rtx 4090</text>
  </g>

  <!-- outbound edge: laptop → axcrew → gpu -->
  <g>
    <line class="edge-flow" x1={laptop.x} y1={laptop.y + boxH / 2 + 26} x2={hub.x} y2={hub.y + boxH / 2 + 26} stroke="var(--color-line-dark-2)" stroke-width="1" />
    <path class="edge-flow" d={`M ${hub.x} ${hub.y + boxH / 2 + 26} L ${gpu.x} ${gpu.y + boxH / 2 + 26}`} stroke="var(--color-line-dark-2)" stroke-width="1" fill="none" />
    <path d={`M ${gpu.x - 16} ${gpu.y + boxH / 2 + 22} L ${gpu.x} ${gpu.y + boxH / 2 + 26} L ${gpu.x - 16} ${gpu.y + boxH / 2 + 30}`} stroke="var(--color-fog-2)" stroke-width="1" fill="none" />
  </g>

  <!-- result edge: gpu → axcrew → laptop -->
  <g>
    <line class="edge-flow" x1={gpu.x} y1={gpu.y - boxH / 2 - 26} x2={hub.x} y2={hub.y - boxH / 2 - 26} stroke="var(--color-line-dark-2)" stroke-width="1" />
    <path class="edge-flow" d={`M ${hub.x} ${hub.y - boxH / 2 - 26} L ${laptop.x} ${laptop.y - boxH / 2 - 26}`} stroke="var(--color-line-dark-2)" stroke-width="1" fill="none" />
    <path d={`M ${laptop.x + 16} ${laptop.y - boxH / 2 - 30} L ${laptop.x} ${laptop.y - boxH / 2 - 26} L ${laptop.x + 16} ${laptop.y - boxH / 2 - 22}`} stroke="var(--color-fog-2)" stroke-width="1" fill="none" />
  </g>

  <!-- labels -->
  <g font-family="var(--font-mono)" font-size="10">
    <text x={hub.x} y={hub.y + boxH / 2 + 44} text-anchor="middle" fill="var(--color-fog)">t-1042 · run "test suite"</text>
    <text x={hub.x} y={hub.y - boxH / 2 - 44} text-anchor="middle" fill="var(--color-ok)">result · 214 passed · 0 failed</text>
  </g>

  <!-- packets: outbound dot + inbound dot -->
  <g>
    <circle class="packet-out" cx={laptop.x} cy={laptop.y + boxH / 2 + 26} r="3.5" fill="var(--color-fog)" />
    <circle class="packet-back" cx={gpu.x} cy={gpu.y - boxH / 2 - 26} r="3.5" fill="var(--color-ok)" />
  </g>
</svg>
