---
/**
 * SendWork — a clean numbered task journey.
 * Uses TASK_JOURNEY from topology.ts.
 */
import { TASK_JOURNEY, machineOf } from '../lib/topology';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';
---

<div class="mx-auto max-w-2xl">

  <!-- trigger -->
  <div class="mb-10 border-b border-[var(--color-border)] pb-8">
    <p class="mono-micro mb-2">{z ? '触发' : 'trigger'}</p>
    <p class="font-mono text-base font-medium tracking-[-0.01em] text-[var(--color-text)] sm:text-lg">
      ax run <span class="text-[var(--color-text-3)]">&ldquo;{TASK_JOURNEY[0].cmd.replace(/^ax run [""]?/, '').replace(/[""]?$/, '')}&rdquo;</span>
    </p>
  </div>

  <!-- steps -->
  <ol class="space-y-0">
    {
      TASK_JOURNEY.map((s, i) => {
        const isLast = i === TASK_JOURNEY.length - 1;
        const name = s.actor === 'axcrew' ? 'AXCrew' : machineOf(s.actor).name[lang];
        const isDone = s.kind === 'done';
        const isCrew = s.kind === 'crew';

        return (
          <li class="relative flex gap-5">
            <!-- timeline -->
            <div class="flex shrink-0 flex-col items-center">
              <div
                class:list={[
                  'relative z-10 mt-0.5 flex h-7 w-7 items-center justify-center rounded-full font-mono text-[0.6875rem] font-semibold',
                  isDone
                    ? 'bg-[var(--color-ok)] text-white'
                    : isCrew
                    ? 'bg-[var(--color-text)] text-[var(--color-bg)]'
                    : 'border border-[var(--color-border-strong)] bg-[var(--color-bg)] text-[var(--color-text-3)]',
                ]}
              >
                {i + 1}
              </div>
              {!isLast && <div class="mt-1 w-px flex-1 bg-[var(--color-border)]"></div>}
            </div>

            <!-- content -->
            <div class:list={['min-w-0 pb-7', isLast && 'pb-0']}>
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                <span
                  class:list={[
                    'text-[0.9375rem] font-semibold tracking-[-0.01em]',
                    isDone
                      ? 'text-[var(--color-ok)]'
                      : isCrew
                      ? 'text-[var(--color-text-2)]'
                      : 'text-[var(--color-text)]',
                  ]}
                >
                  {name}
                </span>
                {i > 0 && (
                  <span class="font-mono text-[0.8125rem] text-[var(--color-text-3)]">{s.cmd}</span>
                )}
              </div>
              <p class="mt-0.5 font-mono text-[0.75rem] text-[var(--color-text-3)]">
                {s.out[lang]}
              </p>
            </div>
          </li>
        );
      })
    }
  </ol>
</div>
