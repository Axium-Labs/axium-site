---
/**
 * CrewUI — how AXCrew actually works: it orchestrates AX instances,
 * not hardware. Each row is an independent AX (its own model, skills,
 * memory, permissions); AXCrew schedules across them and brokers approvals.
 */
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';

/* one AX instance = one independent agent runtime */
const INSTANCES = z
  ? [
      { name: 'ax · dev',     runs: '本机 · wsl',    model: 'gpt-5',        state: 'idle',    work: '空闲 · 就绪' },
      { name: 'ax · build',   runs: '构建机',        model: 'claude-4.5',   state: 'running', work: 'cargo test --lib sort' },
      { name: 'ax · bench',   runs: 'GPU 机器',      model: 'gpt-5',        state: 'running', work: 'cargo bench --bench sort' },
      { name: 'ax · remote',  runs: '云虚拟机',      model: 'deepseek-v3',  state: 'offline', work: '离线' },
    ]
  : [
      { name: 'ax · dev',    runs: 'local · wsl',  model: 'gpt-5',       state: 'idle',    work: 'idle · ready' },
      { name: 'ax · build',  runs: 'build box',    model: 'claude-4.5',  state: 'running', work: 'cargo test --lib sort' },
      { name: 'ax · bench',  runs: 'GPU box',      model: 'gpt-5',       state: 'running', work: 'cargo bench --bench sort' },
      { name: 'ax · remote', runs: 'cloud VM',     model: 'deepseek-v3', state: 'offline', work: 'offline' },
    ];

const STATE_TONE: Record<string, string> = {
  running: 'text-[var(--color-ok)]',
  idle:    'text-[var(--color-text-3)]',
  offline: 'text-[var(--color-text-3)]',
};

/* what AXCrew does with those instances */
const ORCHESTRATION = z
  ? [
      { t: '派发', d: '按能力与资源把任务放到某个 AX 实例。' },
      { t: '隔离', d: '每个实例有自己的模型、技能、记忆与权限。' },
      { t: '审批', d: '权限请求汇到控制面，由你批准或拒绝。' },
      { t: '恢复', d: '实例掉线后，任务按租约重新分配。' },
    ]
  : [
      { t: 'Dispatch',  d: 'Place a task on an AX instance by capability and resources.' },
      { t: 'Isolate',   d: 'Each instance has its own model, skills, memory and permissions.' },
      { t: 'Approve',   d: 'Permission requests reach the control plane for your decision.' },
      { t: 'Recover',   d: 'When an instance drops, the task is re-assigned by lease.' },
    ];

/* pending approvals on the control plane */
const APPROVALS = z
  ? [
      { req: 'filesystem · write tests/sort_test.rs', from: 'ax · dev' },
      { req: 'shell · cargo test --lib sort',         from: 'ax · build' },
    ]
  : [
      { req: 'filesystem · write tests/sort_test.rs', from: 'ax · dev' },
      { req: 'shell · cargo test --lib sort',         from: 'ax · build' },
    ];
---

<div class="grid gap-px overflow-hidden border border-[var(--color-border)] bg-[var(--color-border)] lg:grid-cols-[1.5fr_1fr]">

  <!-- ── the orchestrated AX instances ── -->
  <div class="bg-[var(--color-bg)]">
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-3">
      <span class="mono-micro">{z ? 'AX 实例 · 由 AXCrew 编排' : 'ax instances · orchestrated by axcrew'}</span>
      <span class="mono-micro">{z ? '4 个实例' : '4 instances'}</span>
    </div>

    <!-- column headers -->
    <div class="hidden grid-cols-[1fr_auto] gap-4 border-b border-[var(--color-border)] bg-[var(--color-bg-raised)] px-5 py-2.5 sm:grid">
      <span class="mono-micro">{z ? '实例 · 运行位置 · 模型' : 'instance · host · model'}</span>
      <span class="mono-micro">{z ? '当前工作' : 'current work'}</span>
    </div>

    <ul>
      {
        INSTANCES.map((inst) => {
          const isOffline = inst.state === 'offline';
          return (
            <li class="border-b border-[var(--color-border)] px-5 py-4 last:border-b-0">
              <div class="flex items-baseline justify-between gap-4">
                {/* identity */}
                <div class="min-w-0">
                  <div class="flex items-baseline gap-2.5">
                    <span
                      class:list={[
                        'font-mono text-[0.8125rem] font-medium',
                        isOffline ? 'text-[var(--color-text-3)]' : 'text-[var(--color-text)]',
                      ]}
                    >
                      {inst.name}
                    </span>
                    <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', inst.state === 'running' ? 'bg-[var(--color-ok)]' : inst.state === 'idle' ? 'bg-[var(--color-border-strong)]' : 'bg-[var(--color-border)]']} />
                  </div>
                  <p class="mono-micro mt-1">
                    {inst.runs} &nbsp;·&nbsp; {inst.model}
                  </p>
                </div>

                {/* work */}
                <div class="min-w-0 text-right">
                  <p
                    class:list={[
                      'truncate font-mono text-[0.75rem]',
                      isOffline ? 'text-[var(--color-text-3)]' : 'text-[var(--color-text-2)]',
                    ]}
                  >
                    {inst.work}
                  </p>
                  <p class:list={['mono-micro mt-1', STATE_TONE[inst.state]]}>
                    {inst.state}
                  </p>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    <!-- orchestration: what Crew does across them -->
    <div class="border-t border-[var(--color-border)] bg-[var(--color-bg-raised)] p-5">
      <p class="mono-micro mb-4">{z ? 'AXCrew 在做的四件事' : 'what axcrew does across them'}</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          ORCHESTRATION.map((o) => (
            <div>
              <p class="text-[0.8125rem] font-medium text-[var(--color-text)]">{o.t}</p>
              <p class="mt-0.5 text-[0.75rem] leading-relaxed text-[var(--color-text-2)]">{o.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ── the control plane: approvals ── -->
  <div class="bg-[var(--color-bg)]">
    <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-3">
      <span class="mono-micro">{z ? '控制面 · 待审批' : 'control plane · approvals'}</span>
      <span class="mono-micro">2</span>
    </div>

    <ul>
      {
        APPROVALS.map((a) => (
          <li class="border-b border-[var(--color-border)] px-5 py-4">
            <p class="font-mono text-[0.75rem] leading-relaxed text-[var(--color-text-2)] break-words">
              {a.req}
            </p>
            <p class="mono-micro mt-1.5">
              {z ? '来自' : 'from'} {a.from}
            </p>
            <div class="mt-3 flex gap-1.5">
              <span class="bg-[var(--color-text)] px-3 py-1.5 font-mono text-[0.6875rem] text-[var(--color-bg)]">
                {z ? '批准' : 'approve'}
              </span>
              <span class="border border-[var(--color-border)] px-3 py-1.5 font-mono text-[0.6875rem] text-[var(--color-text-3)]">
                {z ? '拒绝' : 'deny'}
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- event stream -->
    <div class="p-5">
      <p class="mono-micro mb-3">{z ? '事件流' : 'event stream'}</p>
      <ul class="space-y-2">
        {
          [
            'ax · build → cargo test --lib sort',
            'axcrew · route → ax · bench',
            'ax · bench → 214 runs · p50 3.1ms',
            'axcrew · lease renewed · ax · build',
          ].map((line) => (
            <li class="font-mono text-[0.6875rem] leading-relaxed text-[var(--color-text-3)] break-words">
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

</div>
