---
/**
 * CrewConsole — the AXCrew control view (desktop / mobile):
 * one pane listing every node and streaming every event.
 * Static, monochrome.
 */
import { CONSOLE_EVENTS, DEVICES } from '../lib/topology';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const z = lang === 'zh';
---

<div class="panel-light grid-bg-light">
  <div class="hairline-b flex items-center justify-between bg-paper-2 px-4 py-2.5">
    <span class="mono-micro text-ink-3">axcrew · {z ? '桌面 / 移动端' : 'desktop / mobile'}</span>
    <span class="mono-micro text-ok">{z ? '● 观察中' : '● observing'}</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2">
    <!-- nodes -->
    <div class="hairline-b sm:border-r sm:border-line sm:border-b-0 border-line">
      <div class="hairline-b bg-paper-2 px-4 py-2">
        <span class="mono-micro text-ink-3">{z ? '节点' : 'nodes'}</span>
      </div>
      <ul class="divide-y divide-line">
        {
          DEVICES.map((d, i) => (
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <span class="flex min-w-0 items-center gap-2.5">
                <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${i < 3 ? 'bg-ok pulse' : 'bg-ok'}`}></span>
                <span class="truncate font-mono text-xs text-ink">{d.name[lang]}</span>
                <span class="mono-micro truncate text-ink-3">{d.detail[lang]}</span>
              </span>
              <span class="mono-micro shrink-0 tabular-nums text-ink-2">{d.latency}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- events -->
    <div>
      <div class="hairline-b bg-paper-2 px-4 py-2">
        <span class="mono-micro text-ink-3">{z ? '实时事件 · CrewEvent' : 'live events · CrewEvent'}</span>
      </div>
      <ul class="divide-y divide-line">
        {
          CONSOLE_EVENTS.map((e) => (
            <li class="term truncate px-4 py-2.5 text-ink-2">{e}</li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="hairline-t flex flex-wrap items-center justify-between gap-2 px-4 py-2.5">
    <span class="mono-micro text-ink-3">{z ? `$ axcrew ps --all · 4 在线` : '$ axcrew ps --all · 4 online'}</span>
    <span class="mono-micro text-ink-3">{z ? '调度 · 审批 · 流式' : 'dispatch · approve · stream'}</span>
  </div>
</div>
