---
interface Props {
  id?: string;
  tone?: 'light' | 'dark' | 'paper2';
  kicker?: string;
  title?: string;
  lead?: string;
  /** width of the body slot; 'reading' narrows prose, default full container */
  bodyWidth?: 'full' | 'reading' | 'reading-wide';
  /** suppress the default top hairline (used by the hero) */
  flush?: boolean;
}

const { id, tone = 'light', kicker, title, lead, bodyWidth = 'full', flush = false } = Astro.props;
const dark = tone === 'dark';
---

<section
  id={id}
  class:list={[
    'relative',
    dark ? 'bg-void text-fog' : tone === 'paper2' ? 'bg-paper-2 text-ink' : 'bg-paper text-ink',
    !flush && 'hairline-t',
  ]}
>
  <div class="container-x section-pad">
    {
      kicker || title ? (
        <div class="container-reading mb-14 md:mb-20">
          {kicker && <p class:list={['kicker', dark && 'kicker-dark']}>{kicker}</p>}
          {title && <h2 class:list={['h2 mt-4']}>{title}</h2>}
          {lead && <p class:list={['lede mt-6', dark && 'text-fog-2']}>{lead}</p>}
        </div>
      ) : null
    }
    <div class:list={[bodyWidth === 'reading' && 'container-reading', bodyWidth === 'reading-wide' && 'container-reading-wide']}>
      <slot />
    </div>
  </div>
</section>
