---
interface Props {
  id?: string;
  tone?: 'light' | 'raised' | 'dark';
  kicker?: string;
  title?: string;
  lead?: string;
  size?: 'lg' | 'sm';
  flush?: boolean;
}

const { id, tone = 'light', kicker, title, lead, size = 'lg', flush = false } = Astro.props;

const bg =
  tone === 'dark'
    ? 'bg-[var(--color-void)] text-[var(--color-void-text)]'
    : tone === 'raised'
    ? 'bg-[var(--color-bg-raised)]'
    : 'bg-[var(--color-bg)]';

const border = tone === 'dark' ? 'border-[var(--color-void-border)]' : 'border-[var(--color-border)]';
---

<section
  id={id}
  class:list={['relative', bg, !flush && 'border-t', !flush && border]}
>
  <div class:list={['container-x', size === 'lg' ? 'section-y' : 'section-y-sm']}>
    {
      (kicker || title) && (
        <div class="mb-12 max-w-2xl md:mb-14">
          {kicker && (
            <p class:list={['label mb-3 block', tone === 'dark' && 'label-dark']}>{kicker}</p>
          )}
          {title && <h2 class="h2 text-balance">{title}</h2>}
          {lead && (
            <p
              class:list={[
                'mt-4 max-w-xl text-[0.9375rem] leading-relaxed',
                tone === 'dark' ? 'text-[var(--color-void-text-2)]' : 'text-[var(--color-text-2)]',
              ]}
            >
              {lead}
            </p>
          )}
        </div>
      )
    }
    <slot />
  </div>
</section>
